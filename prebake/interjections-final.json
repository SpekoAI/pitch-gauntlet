{
  "_note": "FINAL interjection library, Claude-authored 2026-07-12. Replaces Codex placeholder lines in prebake/interjections.json. Tone: blunt VC, delivery-critique only, never about the idea's merit, never profane. ASCII only. Keep lines short - they synthesize faster and land harder. tags = trigger types this line can answer.",
  "personas": [
    { "id": "skeptic", "name": "The Skeptic", "casting": "deep, dry, unhurried male", "style": "weary partner who has seen everything" },
    { "id": "spreadsheet", "name": "The Spreadsheet", "casting": "fast, clipped, precise female", "style": "numbers or nothing" },
    { "id": "vibes", "name": "The Vibes Angel", "casting": "relaxed drawl, any gender", "style": "chaotic gut-feel angel" }
  ],
  "lines": [
    { "personaId": "skeptic", "lineId": "sk-01", "text": "Stop. What does it actually do?", "tags": ["buzzword", "monologue"] },
    { "personaId": "skeptic", "lineId": "sk-02", "text": "Everyone says that. Why you?", "tags": ["buzzword", "monologue"] },
    { "personaId": "skeptic", "lineId": "sk-03", "text": "That is a feature, not a company.", "tags": ["monologue"] },
    { "personaId": "skeptic", "lineId": "sk-04", "text": "Who wakes up needing this?", "tags": ["monologue", "no-number"] },
    { "personaId": "skeptic", "lineId": "sk-05", "text": "I have heard this pitch three times this week.", "tags": ["buzzword"] },
    { "personaId": "skeptic", "lineId": "sk-06", "text": "Sure. But why now?", "tags": ["monologue"] },
    { "personaId": "skeptic", "lineId": "sk-07", "text": "That is not a moat. That is a head start.", "tags": ["buzzword"] },
    { "personaId": "skeptic", "lineId": "sk-08", "text": "Wait. Who is the customer? Specifically.", "tags": ["monologue", "no-number"] },
    { "personaId": "skeptic", "lineId": "sk-09", "text": "You are describing the demo. Describe the business.", "tags": ["monologue"] },
    { "personaId": "skeptic", "lineId": "sk-10", "text": "What breaks if you are wrong?", "tags": ["monologue"] },
    { "personaId": "skeptic", "lineId": "sk-11", "text": "I stopped listening at synergy.", "tags": ["buzzword"] },
    { "personaId": "skeptic", "lineId": "sk-12", "text": "Say the sentence a customer would say about you.", "tags": ["filler", "monologue"] },
    { "personaId": "skeptic", "lineId": "sk-13", "text": "What do you know that everyone else missed?", "tags": ["monologue"] },
    { "personaId": "skeptic", "lineId": "sk-14", "text": "Slow down. Now say the true part.", "tags": ["filler"] },
    { "personaId": "spreadsheet", "lineId": "sp-01", "text": "Numbers. Now.", "tags": ["no-number"] },
    { "personaId": "spreadsheet", "lineId": "sp-02", "text": "Twenty five seconds in. Not one number.", "tags": ["no-number"] },
    { "personaId": "spreadsheet", "lineId": "sp-03", "text": "What is your CAC?", "tags": ["no-number", "monologue"] },
    { "personaId": "spreadsheet", "lineId": "sp-04", "text": "Revenue. Is there any?", "tags": ["no-number"] },
    { "personaId": "spreadsheet", "lineId": "sp-05", "text": "How many users yesterday? Not total. Yesterday.", "tags": ["no-number", "monologue"] },
    { "personaId": "spreadsheet", "lineId": "sp-06", "text": "What is the margin on that?", "tags": ["monologue"] },
    { "personaId": "spreadsheet", "lineId": "sp-07", "text": "Churn. Monthly. Go.", "tags": ["no-number"] },
    { "personaId": "spreadsheet", "lineId": "sp-08", "text": "That market size includes my grandmother. Narrow it.", "tags": ["buzzword", "monologue"] },
    { "personaId": "spreadsheet", "lineId": "sp-09", "text": "Growth rate, or it did not happen.", "tags": ["no-number"] },
    { "personaId": "spreadsheet", "lineId": "sp-10", "text": "What does one customer pay you?", "tags": ["no-number", "monologue"] },
    { "personaId": "spreadsheet", "lineId": "sp-11", "text": "Burn. Runway. Months. Three numbers. Go.", "tags": ["no-number"] },
    { "personaId": "spreadsheet", "lineId": "sp-12", "text": "Percent, week over week. Or I am out.", "tags": ["no-number"] },
    { "personaId": "spreadsheet", "lineId": "sp-13", "text": "Unit economics. One sentence.", "tags": ["monologue"] },
    { "personaId": "spreadsheet", "lineId": "sp-14", "text": "How much of that is real booked money?", "tags": ["no-number"] },
    { "personaId": "vibes", "lineId": "vb-01", "text": "Okay. But would my mom use this?", "tags": ["monologue"] },
    { "personaId": "vibes", "lineId": "vb-02", "text": "Vibes are good. Business unclear.", "tags": ["buzzword", "monologue"] },
    { "personaId": "vibes", "lineId": "vb-03", "text": "I invest in founders. Right now the founder is rambling.", "tags": ["monologue", "filler"] },
    { "personaId": "vibes", "lineId": "vb-04", "text": "Love the energy. Lost the plot.", "tags": ["filler", "monologue"] },
    { "personaId": "vibes", "lineId": "vb-05", "text": "Say it like you are texting a friend.", "tags": ["buzzword", "filler"] },
    { "personaId": "vibes", "lineId": "vb-06", "text": "Is this a company or a weekend project?", "tags": ["monologue"] },
    { "personaId": "vibes", "lineId": "vb-07", "text": "You breathing? Breathe.", "tags": ["filler"] },
    { "personaId": "vibes", "lineId": "vb-08", "text": "I was with you until platform.", "tags": ["buzzword"] },
    { "personaId": "vibes", "lineId": "vb-09", "text": "Fun. Anyway. What is it?", "tags": ["monologue", "buzzword"] },
    { "personaId": "vibes", "lineId": "vb-10", "text": "My gut says maybe. Convince my gut.", "tags": ["monologue"] },
    { "personaId": "vibes", "lineId": "vb-11", "text": "You are pitching the slide. Pitch the dream.", "tags": ["monologue"] },
    { "personaId": "vibes", "lineId": "vb-12", "text": "Cool cool cool. Who pays?", "tags": ["no-number"] },
    { "personaId": "vibes", "lineId": "vb-13", "text": "One sentence. Make me feel something.", "tags": ["filler", "monologue"] },
    { "personaId": "vibes", "lineId": "vb-14", "text": "I would swipe past this on demo day.", "tags": ["monologue"] },
    { "personaId": "skeptic", "lineId": "sk-silence-01", "text": "Hello? We are waiting.", "tags": ["silence"] },
    { "personaId": "spreadsheet", "lineId": "sp-silence-01", "text": "The silence is not helping your valuation.", "tags": ["silence"] },
    { "personaId": "vibes", "lineId": "vb-silence-01", "text": "Take your time. The market will not.", "tags": ["silence"] },
    { "personaId": "skeptic", "lineId": "sk-open-01", "text": "You have ninety seconds. Impress us.", "tags": ["opener"] },
    { "personaId": "spreadsheet", "lineId": "sp-open-01", "text": "Clock starts now. Numbers early, please.", "tags": ["opener"] },
    { "personaId": "vibes", "lineId": "vb-open-01", "text": "No pressure. Except all of it.", "tags": ["opener"] }
  ],
  "slotTemplates": [
